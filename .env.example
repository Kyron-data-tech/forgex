# =============================================================================
# ForgeX — Environment Configuration Template
# Copy this file to ".env" and fill in your values.
# NEVER commit ".env" to version control.
# =============================================================================

# ── Server (strictly localhost) ───────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=False

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# ── Storage ───────────────────────────────────────────────────────────────────
DEFAULT_DATA_DIR=./data_storage
MAX_IMAGE_SIZE_BYTES=10485760
MIN_FREE_DISK_BYTES=2147483648

# ── Automation ────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=True
DEFAULT_TIMEOUT_MS=15000
MAX_JOBS_PER_HOUR=30

# ── WorldHeroes credentials (saved via Settings page — do not edit manually) ──
# These are written automatically when you click "Save & Login" in the app.
WH_EMAIL=
WH_PASSWORD=
